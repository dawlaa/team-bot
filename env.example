DISCORD_TOKEN=حط_التوكن_هنا
# اختياري: ID السيرفر عشان الأوامر تظهر فورًا (من غيره ممكن تاخد لحد ساعة)
GUILD_ID=
# اختياري: مكان ملف قاعدة البيانات
DB_PATH=tracker.db
# المنطقة الزمنية الافتراضية للبوستات والتقارير (ممكن تتغير بـ /settings timezone)
TZ_NAME=Africa/Cairo
# 1 = يفعّل قراءة محتوى الرسائل (للترانسكريبت في التيكيتات ولوج تعديل/مسح الرسائل)
# لازم تفعّل Message Content Intent من بوابة المطورين الأول، وإلا البوت مش هيشتغل
MESSAGE_CONTENT=0
